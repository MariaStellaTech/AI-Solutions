NODE_ENV=production
# Port for local development. In many cloud hosts, PORT is auto-provided at runtime.
PORT=8080
APP_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASS=admin123

# Installer protection
INSTALL_TOKEN=
INSTALL_MAINTENANCE_MODE=false

# Security options
TRUST_PROXY=false
CSP_RELAXED=false
DATA_ENCRYPTION_KEY=change-this-to-a-strong-random-value
REQUIRE_WIDGET_CALLER_HEADERS=true

# CORS allowlist (use explicit origins in production; avoid *)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
